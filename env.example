# Database Configuration
# SQLite is used by default for local development (no setup required)
DATABASE_URL=sqlite:///./gebeyaalert.db

# For PostgreSQL in production, uncomment and set DATABASE_URL_PROD:
# DATABASE_URL_PROD=postgresql://user:password@localhost:5432/gebeyaalert
# ENVIRONMENT=production

# JWT Secret Key
# For development: Default key is fine (auto-generated if not set)
# For production: Generate a strong random string
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# SECRET_KEY=your-production-secret-key-here

# Application Settings
ENVIRONMENT=development
DEBUG=True
FRONTEND_URL=http://localhost:3000

# Twilio SMS Configuration (Optional)
# Sign up at https://www.twilio.com to get these credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SMS_ENABLED=False

# Celery/Redis Configuration (Optional, for background tasks)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Server Port (optional, defaults to 8080)
PORT=8080

