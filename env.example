# Database Configuration
# 
# LOCAL DEVELOPMENT (SQLite - default):
# Leave DATABASE_URL unset or comment it out to use SQLite
# SQLite database file will be created automatically at ./gebeyaalert.db
#
# PRODUCTION/DEPLOYMENT (PostgreSQL):
# Set DATABASE_URL to your PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# Example: postgresql://user:pass@localhost:5432/gebeyaalert
# 
# For Render/Supabase/other services, they usually provide DATABASE_URL automatically
# DATABASE_URL=postgresql://user:password@host:port/database

# JWT Secret Key
# For development: Default key is fine (auto-generated if not set)
# For production: Generate a strong random string
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# SECRET_KEY=your-production-secret-key-here

# Application Settings
# Set ENVIRONMENT=production for deployment
ENVIRONMENT=development
DEBUG=True
FRONTEND_URL=http://localhost:3000

# For production deployment, also set:
# ENVIRONMENT=production
# DEBUG=False
# SECRET_KEY=<generate-a-strong-random-key>

# SMS Configuration
# For demo/testing: Use "console" to log SMS to terminal (no cost)
# For production: Use "twilio" and configure Twilio credentials below
SMS_PROVIDER=console  # Options: "console" (demo) or "twilio" (production)
SMS_ENABLED=False  # Set to True when using Twilio provider

# Twilio SMS Configuration (Only required if SMS_PROVIDER=twilio)
# Sign up at https://www.twilio.com to get these credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Celery/Redis Configuration (Optional, for background tasks)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Server Port (optional, defaults to 8080)
PORT=8080
